# 复制为 .env，填写自己的配置。现有环境变量优先。
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-tool-capable-model
AGENT_TIMEOUT=30
AGENT_MAX_RETRIES=2
AGENT_MAX_ROUNDS=10
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_CONTEXT_CHARS=100000
WORKFLOW_MAX_FIXES=2
WORKFLOW_MAX_MODEL_CALLS=40
WORKFLOW_OUTPUT_DIR=runs
